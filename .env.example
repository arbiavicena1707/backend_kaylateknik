# ========================================================
# Konfigurasi Backend Nota & Surat Penawaran (Mikayla Teknik)
# ========================================================

# Port Server Node.js (biarkan default atau sesuai cPanel)
PORT=5000

# Kunci JWT untuk keamanan Login & Token Autentikasi
JWT_SECRET=mikayla_teknik_secret_key_jwt_2024

# ========================================================
# KONEKSI DATABASE MYSQL / PHPMYADMIN (cPanel)
# ========================================================
# Di cPanel:
# DB_HOST umumnya selalu: localhost
DB_HOST=localhost
DB_PORT=3306

# Ganti dengan Nama Database yang dibuat di cPanel (cth: mikayla_notadb)
DB_NAME=namausercpanel_notadb

# Ganti dengan Username Database yang dibuat di cPanel (cth: mikayla_dbuser)
DB_USER=namausercpanel_dbuser

# Ganti dengan Password User Database yang dibuat di cPanel
DB_PASSWORD=password_database_anda
